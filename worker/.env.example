# ═════════════════════════════════════════════════════════════════════════
# Channels worker — env
# ═════════════════════════════════════════════════════════════════════════
# The worker connects to the same Supabase project as the portal so it
# reads chat_inboxes, listens for chat_outbound_queue rows, and writes
# inbound chat_messages back.

# ── Required ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same key the portal uses — needed to decrypt bot tokens / cookies /
# IMAP passwords stored in chat_inboxes.channel_config.
PROVIDER_ENCRYPTION_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# Worker identity for heartbeats + logs. Defaults to the hostname if
# not set. Useful when running multiple worker replicas.
WORKER_ID=

# Which channel types this worker should handle. Comma-separated. Omit
# to run all supported channels. Useful to shard workloads.
#   WORKER_CHANNELS=zalo,facebook
WORKER_CHANNELS=

# Poll interval for the outbound queue, in milliseconds. Realtime is the
# primary path; the poll is a safety net.
OUTBOUND_POLL_INTERVAL_MS=3000

# Heartbeat interval, in milliseconds. The admin UI uses this to detect
# a healthy worker (< 60s since last beat = green).
HEARTBEAT_INTERVAL_MS=15000
