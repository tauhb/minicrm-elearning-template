{
  "name": "@rainmaker/agentcrm-mcp",
  "version": "0.1.0",
  "description": "MCP server for AgentCRM — control leads / customers / tasks / orders / funnels / chat from Claude Code, Codex, Cursor, or any MCP-compatible AI agent.",
  "type": "module",
  "bin": {
    "agentcrm-mcp": "./dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "EXAMPLES.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm run build && npm publish --access public"
  },
  "keywords": ["mcp", "model-context-protocol", "crm", "claude", "codex", "cursor", "agentcrm", "rainmaker"],
  "author": "Rainmaker",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
