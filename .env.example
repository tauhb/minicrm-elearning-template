# Supabase Project (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First admin account email (create this user in Supabase Auth first, then set role='admin' in profiles)
VITE_ADMIN_EMAIL=admin@yourdomain.com

# Resend (email branding) — lấy API key tại resend.com, free 3000 email/tháng
# Sau khi có key: paste vào đây VÀ vào Cài đặt → Email trong app
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets CRM — mirror leads sang Sheets nếu muốn dùng cả 2 hệ thống
# Lấy URL từ Apps Script webhook (skills/funnel/crm/SKILL.md)
# Để trống nếu chỉ dùng Customer Portal
GOOGLE_SHEETS_WEBHOOK_URL=

# Webhook Secret — xác thực request từ landing page / phễu bán hàng
# Có thể tạo tự động trong Cài đặt → Webhook, hoặc đặt thủ công tại đây
# Ưu tiên: WEBHOOK_SECRET env var > app_settings trong DB
WEBHOOK_SECRET=

# Brevo — Marketing email layer (lead nurture + onboarding sequences)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_LIST_ID_LEADS=
BREVO_LIST_ID_CUSTOMERS=
BREVO_LIST_ID_REENGAGEMENT=

# Customer Portal — URL của app này sau khi deploy
CUSTOMER_PORTAL_URL=https://your-portal.vercel.app
CUSTOMER_PORTAL_WEBHOOK_SECRET=

# AI Providers — encryption key cho OAuth tokens (ChatGPT, Claude, ...)
# Generate: openssl rand -hex 32
# Cần thiết nếu dùng Funnel Builder / AI generation features
PROVIDER_ENCRYPTION_KEY=
